alias xfm="source ~/bashscripts/bash-manager.sh && source ~/bashscripts/xfm_append.sh && xfm learn on"

# SSH Transfer Script (moved to 3worlds.sh)

# --- 7. THE ULTIMATE HELP UTILITY ---

help() {
    echo -e "${CYAN}======================================================${NC}"
    echo -e "   🚀 ${BOLD}JOE'S MISSION CONTROL - COMMAND LIST${NC}"
    echo -e "${CYAN}======================================================${NC}"
    
    echo -e "${YELLOW}${BOLD}🔹 [ CUSTOM FUNCTIONS ]${NC}"
    grep -E -h -B 1 '^[a-zA-Z0-9_-]+\(\)' ~/bashscripts/.bashjoe | while read -r line; do
        if [[ $line == "# ---"* ]] || [[ $line == "# ==="* ]]; then last_comment=""
        elif [[ $line == "#"* ]]; then last_comment="${line#*# }"
        elif [[ $line == *"()"* ]]; then
            func_name=$(echo $line | cut -d'(' -f1)
            if [[ "$func_name" =~ ^(ble|__|_|bash_|quote) ]]; then continue; fi
            printf "  \033[32m%-15b\033[0m \033[90m%b\033[0m\n" "${func_name}" "${last_comment}"
            last_comment=""
        fi
    done

    echo -e "\n${YELLOW}${BOLD}🔹 [ ALIASES ]${NC}"
    grep -E -h -B 1 '^alias [a-zA-Z0-9_-]+=' ~/bashscripts/.bashjoe | while read -r line; do
        if [[ $line == "# ---"* ]] || [[ $line == "# ==="* ]]; then last_comment=""
        elif [[ $line == "#"* ]]; then last_comment="${line#*# }"
        elif [[ $line == "alias "* ]]; then
            alias_name=$(echo $line | cut -d'=' -f1 | sed 's/alias //')
            printf "  \033[36m%-15b\033[0m \033[90m%b\033[0m\n" "${alias_name}" "${last_comment}"
            last_comment=""
        fi
    done
    
    echo -e "${CYAN}======================================================${NC}"
    echo -e " Tip: Type ${GREEN}'h'${NC} to see this list."
    echo -e " Env: ${MAGENTA}${JOE_ENV}${NC}"
}

alias h='help'
alias reload='source ~/.bashrc && echo -e "${GREEN}✅ Config reloaded!${NC}"'

# --- Python Infrastructure Sync ---
pysync() {
    echo -e "${CYAN}🔄 Syncing Global Dashboard Python Environment (3.9)...${NC}"
    cd "$HOME/dashboard"
    # Ensure standard python is 3.9
    if [ ! -d ".venv" ]; then
        uv venv --python 3.9 .venv
    fi
    uv pip install -r requirements_all.txt
    # Install Playwright browsers if needed
    $DASHBOARD_PYTHON -m playwright install chromium
    echo -e "${GREEN}✅ Python 3.9 environment synced!${NC}"
}



#source ~/bashscripts/echo.sh 

# --- 8. INITIALIZATION ---


full_pipe() {
  echo -e "${CYAN}============= Full Pipe Line ==============${NC}"
	enp
	$DASHBOARD_PYTHON pipeline_engine.py
}
alias fbrun="full_pipe"

gpc() {
    if [ -z "$1" ]; then
        # ถ้าไม่ใส่เลข Port ให้โชว์ LISTEN ทั้งหมด
         ss -tulpn | grep LISTEN
    else
        # ถ้าใส่เลข Port (เช่น gpc 22) ให้กรองเฉพาะ Port นั้น
         ss -tulpn | grep LISTEN | grep ":$1 "
    fi
}


status() {

    echo "🌍 ENV      : $JOE_ENV"

    if [[ -n "$SSH_CONNECTION" ]]; then
        echo "🔐 SSH      : ACTIVE"
    else
        echo "🔐 SSH      : LOCAL"
    fi

    if [[ -n "$TMUX" ]]; then
        echo "🧩 TMUX     : ACTIVE"
    else
        echo "🧩 TMUX     : OFF"
    fi

    if command -v tailscale >/dev/null 2>&1; then
        if tailscale status >/dev/null 2>&1; then
            echo "🌐 TAILSCALE: ONLINE"
        else
            echo "🌐 TAILSCALE: OFFLINE"
        fi
    fi

    echo "📂 PROJECT DIR  : $(basename "$PWD")"

    if command -v claude >/dev/null 2>&1; then
        echo "🤖 AGENT    : claude-code"
    else
        echo "🤖 AGENT    : none"
    fi
}

alias pp="reload"