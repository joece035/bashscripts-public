#!/bin/bash

# ==========================================
# 1. นิยามฟังก์ชัน _check() (เวอร์ชัน Cross-Shell)
# ==========================================
_check() {
    local type="${1:--f}"
    local tar_input="${2:-}"
    local cmd="${3:-source}"
    shift 3

    if declare -p "$tar_input" 2>/dev/null | grep -E -q '(declare|typeset).*-[^=]*[aA]'; then
        local -a items=()

        if [ -n "$ZSH_VERSION" ]; then
            setopt LOCAL_OPTIONS
            unsetopt KSH_ARRAYS 2>/dev/null
            items=("${(@P)tar_input}")
        else
            local -n ref="$tar_input"
            items=("${ref[@]}")
        fi

        for item in "${items[@]}"; do
            test "$type" "$item" && "$cmd" "$item" "$@"
        done
    else
        test "$type" "$tar_input" && "$cmd" "$tar_input" "$@"
    fi    
}       
#-- helper for  functin, alias unbinding
unbind(){
    local mode=""
    local target=""

    # parse flags
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            -a|-f|-af) mode="${1#-}"; shift ;;
            *) break ;;
        esac
    done
    target="${1:-}"
    [ -z "$target" ] && return 0

    # ตรวจ binding type ตาม shell
    local has_alias=0 has_func=0
    case "$JOE_ENV" in
        TERMUX|MUMU)
            local wt
            wt=$(whence -w "$target" 2>/dev/null | cut -d" " -f2)
            [ "$wt" = "alias" ]    && has_alias=1
            [ "$wt" = "function" ] && has_func=1
            ;;
        WSL|GIT-BASH)
            local tt
            tt=$(type -t "$target" 2>/dev/null)
            [ "$tt" = "alias" ]    && has_alias=1
            [ "$tt" = "function" ] && has_func=1
            ;;
        *)
            echo "unknown JOE_ENV: $JOE_ENV"; return 1
            ;;
    esac

    # ลบตาม mode
    local removed=0
    case "$mode" in
        a)
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                echo "done unalias"; echo "  $target"
            else
                echo "⚠ '$target' has no alias"; return 1
            fi
            ;;
        f)
            if (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                echo "done unfunction"; echo "  $target"
            else
                echo "⚠ '$target' has no function"; return 1
            fi
            ;;
        af)
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                echo "done unalias"; echo "  $target"
            fi
            if (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                echo "done unfunction"; echo "  $target"
            fi
            (( removed )) || { echo "⚠ '$target' is not an alias/function"; return 1; }
            ;;
        *)
            # default: ลบตัวที่เจอตัวแรก
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                echo "done unalias"; echo "  $target"
            elif (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                echo "done unfunction"; echo "  $target"
            else
                echo "⚠ '$target' is not an alias/function"; return 1
            fi
            ;;
    esac
}
#-- helper for source in subforder
guard() {
    local target
    local loaded_count=0

    for target in "$@"; do
        # 1. ถ้าเป็นโฟลเดอร์ ให้ค้นหาไฟล์ *.sh ในโฟลเดอร์ย่อยทั้งหมด (Recursive)
        if [ -d "$target" ]; then
            # ใช้ find ค้นหาไฟล์ -type f ที่ชื่อลงท้ายด้วย .sh
            while IFS= read -r file; do
                [ -f "$file" ] && source "$file" && ((loaded_count++))
            done < <(find "$target" -type f -name "*.sh" 2>/dev/null | sort)

        # 2. ถ้าเป็นไฟล์ธรรมดา ให้ source ได้เลย
        elif [ -f "$target" ]; then
            source "$target"
            ((loaded_count++))
        fi
    done

    # 3. ถ้าหาไฟล์ไม่เจอเลยทั้งในโฟลเดอร์และไฟล์ที่ระบุ ให้แจ้งเตือน
    if [ "$loaded_count" -eq 0 ]; then
        echo -e "\033[33m[WARNING]\033[0m No valid .sh files found to source from: $*" >&2
        return 1
    fi
}
csh(){
    [[ -z "$1" ]]&& c 198 "b" "SHELL : ";cn ora b "$_SHELL"

    case $1 in
        b|bash) chsh -s bash && cn 10 b 'switched to bash' ;;
        z|zsh) chsh -s zsh && cn 10 b 'switched to zsh' ;;
        
    esac    
}


