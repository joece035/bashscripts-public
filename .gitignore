# ── Syncthing artifacts ──
.stfolder
.stignore
.syncctl/
*.sync-conflict-*

# ── Backup files ──
*.bak
*.bak2
*.bak3
*.orig

# ── Editor / IDE ──
.vscode/
*.swp
*.swo
*~

# ── Python ──
__pycache__/
*.pyc
.venv/
*.egg-info/

# ── OS junk ──
.DS_Store
Thumbs.db

# ── Secrets (Never commit secrets to git!) ──
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.secret